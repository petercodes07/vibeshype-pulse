# Browser settings are public in the built app. Never put API keys here.
VITE_API_URL=
VITE_AUTH_API_URL=
# Demo UI, with no credentials or external services required.
VITE_USE_MOCK=true
# Set true with VITE_USE_MOCK=false to use demo login against your local Pulse API.
VITE_USE_MOCK_AUTH=false
# Development proxy destination; not embedded in browser bundles.
API_PROXY_TARGET=http://127.0.0.1:3001
