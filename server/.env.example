# Bind to your own computer only by default. Set HOST=0.0.0.0 for LAN access.
HOST=127.0.0.1
PORT=3001
# Serve the compiled web app from the same server (run npm run build first).
SERVE_WEB=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local SQLite is the default; no database server is needed.
SQLITE_PATH=./data/pulse.sqlite
# Optional PostgreSQL with pgvector (overrides SQLite):
DATABASE_URL=
# Optional external services: supply your own keys only in server/.env.
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
